{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "spicrawl-price-tracker-demo",
  "main": "src/worker.mjs",
  "account_id": "036bd64d65479473f0effc8c4fb126ff",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "price-tracker.spicrawl.com", "custom_domain": true }],
  // Served only on the custom domain: no *.workers.dev URL and no preview URLs, which would bypass the guards' hostname.
  "workers_dev": false,
  "preview_urls": false,
  // 5 checks per minute per visitor (the Worker keys it by CF-Connecting-IP, an IPv6 address by its /64). period must be 10 or 60.
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "2026102302", "simple": { "limit": 5, "period": 60 } }],
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "spicrawl_demo_events" }],
  // Cloudflare Web Analytics token; leave empty for no analytics script.
  "vars": { "BEACON_TOKEN": "a922203c2b6a47878bf8c8a324898e92", "OPENPANEL_CLIENT_ID": "aefb6c53-27d1-4191-875c-f1605b9e6f26", "OPENPANEL_API_URL": "https://op.yupcha.com/api" }
  // Secrets: SPICRAWL_API_KEY, and optionally TURNSTILE_SITE_KEY + TURNSTILE_SECRET (see demo/README.md).
}
